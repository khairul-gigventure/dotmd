{
  "name": "dotmd",
  "version": "0.1.1",
  "private": true,
  "description": "Arc/Chromium extension: article → clean Markdown",
  "license": "MIT",
  "author": "Khairul Ikhwan Zulkefly",
  "homepage": "https://github.com/khairul-gigventure/dotmd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khairul-gigventure/dotmd.git"
  },
  "bugs": {
    "url": "https://github.com/khairul-gigventure/dotmd/issues"
  },
  "keywords": [
    "chrome-extension",
    "arc",
    "markdown",
    "readability",
    "article",
    "ai"
  ],
  "scripts": {
    "test": "node --test",
    "vendor": "sh scripts/vendor.sh",
    "zip": "sh scripts/package.sh",
    "worker:dev": "wrangler dev -c worker/wrangler.toml --var ALLOW_LOCALHOST:true",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.1.2",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "wrangler": "^4.147.0"
  }
}
